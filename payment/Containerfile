# Card payment gateway image:
#   (cd payment && ./mvnw -q package -DskipTests && docker build -t shop-payment:<tag> -f Containerfile target)
# The base image starts every jar in /deployments with run-java.sh as the non-root user 185;
# JVM flags come from JAVA_OPTS_APPEND; configuration from environment variables (see README).
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.21

LABEL org.opencontainers.image.title="shop-payment" \
      org.opencontainers.image.description="Sai Buoc card payment gateway"

COPY --chown=185:0 payment-gateway.jar /deployments/payment-gateway.jar
EXPOSE 8090
