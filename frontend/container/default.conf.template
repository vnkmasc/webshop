# Rendered by the nginx image at start-up (envsubst of BACKEND_UPSTREAM only).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream shop_backend {
    server ${BACKEND_UPSTREAM};
    keepalive 32;
}

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_vary on;
gzip_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;
server_tokens off;
client_max_body_size 11m;

server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /api/ {
        proxy_pass http://shop_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;
    }

    # Management endpoints are never exposed through the public entry point.
    location /actuator {
        return 404;
    }

    # Hashed assets never change: cache for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /images/ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # The HTML entry point must always be revalidated so new releases are picked up.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Single page application: unknown paths fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
}
