# Quadlet unit: systemd generates shop-payment.service from this file (podman-systemd.unit(5)).
# Installed to /etc/containers/systemd/ by install.sh; manage it with systemctl like any service.
[Unit]
Description=Sai Buoc card payment gateway (container)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=shop-payment
Image=localhost/shop-payment:current
Pull=never
# Generated from /etc/shop/app.env by shop-payment-env (podman reads env files literally, without shell quoting).
EnvironmentFile=/etc/shop/payment.env
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=PAYMENT_BIND_ADDRESS=0.0.0.0
Environment=PAYMENT_LOG_FILE=/var/log/shop-payment/payment.log
# Only the backend on this VM calls the gateway.
PublishPort=127.0.0.1:8090:8090
Volume=/var/log/shop-payment:/var/log/shop-payment:Z
LogDriver=journald

[Service]
Restart=always
TimeoutStartSec=180
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
